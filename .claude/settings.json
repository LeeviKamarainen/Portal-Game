{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Bash(cat *.env)",
      "Bash(type *.env)",
      "Bash(Get-Content *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)"
    ]
  }
}
