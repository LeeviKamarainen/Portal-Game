# Copy to .env (git-ignored) and edit. Compose reads it from this folder.

# The address players type, without https://.
#   No domain yet: your server's IP with dashes + .sslip.io, e.g. IP 203.0.113.7 -> 203-0-113-7.sslip.io
#   With a domain: game.example.com (an A record pointing at the server's IP)
SITE_HOST=203-0-113-7.sslip.io

# Leave empty to keep the AI map generator off. Set a monthly spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=

# open | closed (closed: no new accounts; the admin tool still creates them)
REGISTRATION=open
