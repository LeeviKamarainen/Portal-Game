{
  "name": "portal-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:server": "tsx --test server/test/*.test.ts",
    "server": "tsx watch server/main.ts",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/main.js",
    "admin": "tsx server/admin.ts",
    "gen": "tsx --env-file-if-exists=.env server/gen/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "three": "^0.185.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
